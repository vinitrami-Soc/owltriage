# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so real keys are never committed.

# --- Threat intel (Option 2, Phase 2) ---
VT_API_KEY=
ABUSEIPDB_API_KEY=

# --- ChatOps (Option 2, Phase 3) ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Case management (Option 2, Phase 4) ---
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=
# Set to false only for a lab TheHive with a self-signed certificate
THEHIVE_VERIFY_TLS=true

# --- Tuning ---
# Alert when VirusTotal malicious engine count is greater than this
VT_MALICIOUS_THRESHOLD=5
# Alert when AbuseIPDB confidence score is at least this (0-100)
ABUSEIPDB_CONFIDENCE_THRESHOLD=50
# VirusTotal free tier allows 4 lookups per minute
VT_REQUESTS_PER_MINUTE=4
