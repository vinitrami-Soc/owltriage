# OwlTriage settings for `owltriage alert` (Wazuh alert enrichment).
#
#   cp .env.example .env      then fill in only what you use; everything is optional.
#
# `owltriage hunt` needs none of this. `owltriage alert --demo` works with an empty file.
# .env is in .gitignore so your keys are never committed. Real environment variables
# override values in this file. Full reference: docs/CONFIGURATION.md#env-settings

# ---------------------------------------------------------------- threat intel lookups
# VirusTotal API key: https://www.virustotal.com/gui/my-apikey (the free tier works).
# Without it, lookups are skipped unless you run with --mock.
VT_API_KEY=

# AbuseIPDB API key: https://www.abuseipdb.com/account/api (free tier works).
ABUSEIPDB_API_KEY=

# ---------------------------------------------------------------- chat notifications
# Sent only when an alert is escalated (see the thresholds below).
# Webhook URLs are secrets: anyone who has one can post to your channel.
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
# Slack: an "Incoming Webhooks" app for your workspace
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------- case management
# TheHive 5. A case with the IP and hash as observables is opened for escalated alerts.
THEHIVE_URL=http://localhost:9000
# API key of a TheHive user that is allowed to create cases
THEHIVE_API_KEY=
# Set to false only for a lab TheHive with a self-signed certificate
THEHIVE_VERIFY_TLS=true

# ---------------------------------------------------------------- tuning
# Escalate when MORE than this many VirusTotal engines call the IP or file malicious
VT_MALICIOUS_THRESHOLD=5
# Escalate when the AbuseIPDB confidence score is AT LEAST this (0-100)
ABUSEIPDB_CONFIDENCE_THRESHOLD=50
# VirusTotal requests per minute. The free tier allows 4; set 0 to disable the limit (paid keys)
VT_REQUESTS_PER_MINUTE=4
